{
  "name": "updatereportexcel",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "updatereportexcel.supra.cc.cd",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "supra-reportexcel-releases"
    }
  ]
}
